function trk_0() {
  const ramp = (n, from, to = from) =>
    Array.from({ length: n }, (_, i) => (n > 1 ? from + ((to - from) * i) / (n - 1) : from));

  const gOpen = "[[g2,g3]@2 [bb2,bb3]@2, ~@4]";
  const aPulse = "[a2@1 a2@1 c3@1 a2@1, [a1,a2]@4]";
  const gRun = "[d4@1 g3@1 bb2@1 g2@1, ~@4]";

  return note(
    cat(
      gOpen,
      "[[d3,d4]@2 [g2,g3]@2, ~@4]",
      "[bb2@4, f#2@4]",
      "[bb2@4, f#2@4]",
      gOpen,
      "[[d3,d4]@2 [g2,g3]@2, ~@4]",

      "[~@4, f#2@4, b1@4]",
      "[f#3@4, f#2@4, b1@4]",

      gOpen,
      "[d3@2 g3@2, ~@4]",
      "[f#3@4, [f#2,bb2]@4]",
      "[f#3@4, f#1@4, [f#2,bb2]@4]",
      "[d3@2 bb2@2, g2@2 ~@2]",
      "[a2@2 d3@2, ~@2 f#2@2]",
      "[f#3@2 d3@2, d2@2 d2@2]",
      "[c3@4, ~@1 a2@2 d2@1, eb2@2 f#2@2]",
      "[g2@2 bb2@2, ~@1 g3@2 g3@1, d2@1 ~@1 ~@2, [g1,g2]@4]",
      "[~@1 f#3@2 f#3@1, g3@1 ~@1 ~@2, a2@1 ~@1 c3@1 ~@1, ~@1 a2@1 ~@1 a2@1, [g1,g2]@4]",
      "[f#3@1 bb3@2 bb3@1, bb2@2 d3@2, [bb1,bb2]@4]",
      "[bb3@1 a3@2 a3@1, ~@2 f#2@2, a2@1 ~@1 ~@2, [bb1,bb2]@4]",
      "[a3@1 g3@2 g3@1, g2@2 ~@2, ~@2 bb2@1 ~@1, [g1,g2]@4]",
      "[g3@1 f#3@2 f#3@1, a2@1 ~@1 c3@1 ~@1, [g1,g2]@4]",
      "[f#3@1 bb3@2 bb3@1, bb2@1 ~@1 d3@1 ~@1, [bb1,bb2]@4]",
      "[bb3@1 a3@2 ~@1, a2@1 ~@1 c3@1 a3@1, [bb1,bb2]@4]",

      "[g2@2 bb2@1 g2@1, [g1,g2]@4]",
      aPulse,
      "[bb2@2 d3@1 bb2@1, [bb1,bb2]@4]",
      aPulse,
      "[d4@1 db4@1 bb2@1 g2@1, g2@2 ~@2, [g1,g2]@4]",
      "[db4@1 a2@1 c4@1 a2@1, a2@1 ~@1 c3@1 ~@1, [a1,a2]@4]",
      "[db4@1 bb3@1 d3@1 bb2@1, bb2@1 bb2@1 ~@2, [bb1,bb2]@4]",
      "[c4@1 a2@1 a3@1 a2@1, a2@1 ~@1 c3@1 ~@1, [a1,a2]@4]",

      "[g3@1 g3@1 bb3@1 g3@1, g1@1 d2@1 bb2@1 d2@1]",
      "[f#3@2 a3@1 f#3@1, d2@1 a2@1 f#2@1 a2@1]",
      "[bb3@1 bb3@1 d4@1 bb3@1, bb1@1 f2@1 d3@1 f2@1]",
      "[a3@2 f#3@2, ~@2 [d2,a2]@2]",
      "[g3@1 g3@1 bb3@1 g3@1, g1@1 d2@1 bb2@1 d2@1]",
      "[f#3@1 f#3@1 a3@1 f#3@1, d2@1 a2@1 f#2@1 a2@1]",
      "[bb3@1 a3@1 bb3@1 c4@1, ~@2 ~@1 a3@1]",
      "[f#3@4, ~@2 d3@2, [d2,a2]@4, ~@2 [f#1,f#2]@2]",
      "[g2@2 bb2@2, ~@1 g3@2 g3@1, [g1,g2]@4]",

      "[~@1 f#3@2 f#3@1, g3@1 ~@1 ~@2, a2@1 ~@1 c3@1 ~@1, ~@1 a2@1 ~@1 a2@1, [g1,g2]@4]",
      "[f#3@1 bb3@2 bb3@1, bb2@2 d3@2, [bb1,bb2]@4]",
      "[bb3@1 a3@2 f#3@1, ~@2 f#2@2, a2@1 ~@1 ~@2, [bb1,bb2]@4]",
      "[f#3@1 g3@2 g3@1, g2@2 ~@2, ~@2 bb2@1 ~@1, [g1,g2]@4]",
      "[g3@1 f#3@2 f#3@1, a2@1 ~@1 c3@1 ~@1, [g1,g2]@4]",
      "[f#3@1 bb3@2 bb3@1, bb2@1 ~@1 d3@1 ~@1, [bb1,bb2]@4]",
      "[bb3@1 a3@2 ~@1, a2@1 ~@1 c3@1 a3@1, [bb1,bb2]@4]",
      "[g2@2 bb2@1 g2@1, [g1,g2]@4]",

      aPulse,
      "[bb2@2 d3@1 bb2@1, [bb1,bb2]@4]",
      aPulse,
      "[d4@1 db4@1 bb2@1 g2@1, g2@2 ~@2, [g1,g2]@4]",
      "[db4@1 a2@1 c4@1 a2@1, a2@1 ~@1 c3@1 ~@1, [a1,a2]@4]",
      "[db4@1 bb3@1 d3@1 bb2@1, bb2@2 ~@2, [bb1,bb2]@4]",
      "[a3@1 a2@1 a3@1 f#3@1, a2@1 ~@1 c3@1 ~@1, [a1,a2]@4]",
      gRun,
      gRun,

      "[eb4@1 c4@1 f#3@1 d3@1, ~@4]",
      "[d4@1 c4@1 a3@1 f#3@1, ~@4]",
      gRun,
      "[g4@2 ~@2, d4@1 g3@1 bb2@1 g2@1]",
      "[g4@2 ~@2, eb4@1 c4@1 f#3@1 d3@1]",
      "[[f#3,d4,f#4]@1 f#4@1 f#4@1 f#4@1, d2@1 [b1,eb3,c4]@1 [ab1,c3,a3]@1 [f1,a2,f#3]@1]",
      "[g4@2 bb2@2, g2@1 [g1,g2]@1 bb1@1 bb1@1]",

      "[f#4@2 c3@2, a2@1 [a1,a2]@1 c2@1 c2@1]",
      "[g4@2 ~@2, f#3@1 g3@2 g3@1, bb2@1 [eb2,bb2]@1 g2@1 [eb2,bb2]@1]",
      "[f#4@2 ~@2, f#3@2 ~@2, a2@1 [d2,a2]@1 f#2@1 [c2,a2]@1]",
      "[g4@2 bb3@2, ~@1 eb4@2 g3@1, ~@2 g3@2 ~@2, g2@2 ~@2, bb2@2 ~@2]",
      "[f#4@2 a3@2, g3@1 d4@2 f#3@1, ~@2 f#3@2 ~@2, ~@2 c3@2, a2@2 ~@2]",
      "[g4@2 bb3@2, f#3@1 eb4@2 g3@1, ~@2 g3@2 ~@2, ~@2 d3@1 bb2@1, bb2@2 ~@2]",
      "[f#4@2 [a3,a4]@2, g3@1 d4@2 ~@1, ~@2 f#3@2 ~@2, ~@2 c3@1 a2@1, a2@2 ~@2]",

      "[g4@4, g3@1 eb4@1 bb3@1 g3@1]",
      "[a4@4, c4@1 g4@1 eb4@1 c4@1]",
      "[a3@1 f#4@1 d4@1 a3@1, f#3@4]",
      "[a4@4, ~@1 f#4@1 d4@1 a3@1, d3@4, f#3@1 ~@1 ~@1 [a1,a2]@1]",
      "[g3@1 eb4@1 bb3@1 g3@1, ~@4]",
      "[c4@1 g4@1 eb4@1 c4@1, ~@4]",

      "[a3@1 f#4@1 d4@1 a3@1, ~@4]",
      "[f#3@1 f#4@1 d4@1 d5@1, ~@2 ~@1 d3@1, ~@2 ~@1 d2@1]",
      "[a4@4, d3@4, d2@4]",
      "[g2@2 d3@2, ~@4]",
      "[[g1,g2]@4, ~@4]",
      "[c3@2 eb3@2, ~@4]",
      "[c2@4, ~@4]",

      "[d3@2 f#3@2, ~@4]",
      "[~@2 f#3@2, d2@4, ~@4]",
      gOpen,
      "[d3@2 g1@2, ~@4]",
      "[[g1,g2]@4, ~@4]",
      "[g1@2 ~@2, ~@4]"
    )
  )
    .s('gm_piano')
    .gain(cat(
      ...ramp(6, .18, .24),
      ...ramp(2, .26, .34),
      ...ramp(16, .30),
      ...ramp(8, .34, .42),
      ...ramp(9, .22),
      ...ramp(8, .30),
      ...ramp(9, .32, .40),
      ...ramp(7, .36, .42),
      ...ramp(7, .38, .46),
      ...ramp(6, .34),
      ...ramp(7, .42, .50),
      ...ramp(6, .28, .14)
    ))
    .velocity(perlin.range(0.75, 1))
    .legato(0.7)
    .release(0.55)
    .lpf(5500)
    .room(0.3)
    .size(0.8)
    .delay(0.18)
    .delaytime(0.375)
    .delayfeedback(0.28)
 
  .spectrum({color: "blue"})
  ._pianoroll();
}

